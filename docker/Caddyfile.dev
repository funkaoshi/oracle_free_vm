character.local {
    handle /static/* {
        uri strip_prefix /static
        root * /srv/character
        file_server
    }
    handle {
        reverse_proxy funkaoshi-randomcharacter:8000
    }
}

summon.local {
    handle /static/* {
        uri strip_prefix /static
        root * /srv/summon
        file_server
    }
    handle {
        reverse_proxy funkaoshi-lotfp-summon:8001
    }
}

carcosa.local {
    handle /static/* {
        uri strip_prefix /static
        header Access-Control-Allow-Origin https://save.vs.totalpartykill.ca
        root * /srv/carcosa
        file_server browse
    }
    handle /1807* {
        root * /srv/carcosa
        file_server browse
    }
    handle /704-yards* {
        root * /srv/carcosa
        file_server browse
    }
    handle /sorceress-rituals* {
        root * /srv/carcosa
        file_server browse
    }
    handle {
        reverse_proxy funkaoshi-randomcarcosa:8002
    }
}
