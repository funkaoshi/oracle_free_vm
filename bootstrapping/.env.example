# Copy this file to bootstrapping/.env (gitignored) and fill in a real key
# before running `./deploy.sh bootstrap`.

# Generate at https://login.tailscale.com/admin/settings/keys
# A reusable, pre-authorized key is convenient for re-provisioning; it's only
# consumed if the box isn't already joined to the tailnet.
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MagicDNS name to give this node in the tailnet.
TAILSCALE_HOSTNAME=oci-vqvz
