character.totalpartykill.ca {
    handle /static/* {
        uri strip_prefix /static
        root * /srv/character
        file_server
    }
    handle {
        reverse_proxy funkaoshi-randomcharacter:8000
    }
}

summon.totalpartykill.ca {
    handle /static/* {
        uri strip_prefix /static
        root * /srv/summon
        file_server
    }
    handle {
        reverse_proxy funkaoshi-lotfp-summon:8001
    }
}

carcosa.totalpartykill.ca {
    handle /static/* {
        uri strip_prefix /static
        header Access-Control-Allow-Origin https://save.vs.totalpartykill.ca
        root * /srv/carcosa
        file_server browse
    }
    handle /1807* {
        root * /srv/carcosa
        file_server browse
    }
    handle /704-yards* {
        root * /srv/carcosa
        file_server browse
    }
    handle /sorceress-rituals* {
        root * /srv/carcosa
        file_server browse
    }
    handle {
        reverse_proxy funkaoshi-randomcarcosa:8002
    }
}

drambuie.vqvz.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    handle_path /media/* {
        root * /srv/drambuie
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        reverse_proxy drambuie:8000
    }
}
